[Unit]
Description=Fail2Ban Prometheus Exporter
Wants=network-online.target
After=network-online.target fail2ban.service

[Service]
User=fail2ban-exporter
Group=fail2ban-exporter
ExecStart=/usr/local/bin/fail2ban_exporter --collector.f2b.socket=/var/run/fail2ban/fail2ban.sock --web.listen-address=127.0.0.1:9191
Restart=on-failure

[Install]
WantedBy=multi-user.target

